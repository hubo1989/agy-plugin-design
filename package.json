{
  "name": "agy-plugin-design",
  "version": "0.2.0",
  "private": false,
  "description": "Agy Design Studio — Local-first visual design studio plugin for Google Antigravity (Agy-Daddy microkernel v2)",
  "license": "MIT",
  "homepage": "https://github.com/hubo1989/agy-plugin-design#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hubo1989/agy-plugin-design.git"
  },
  "keywords": [
    "antigravity",
    "agy-daddy",
    "design",
    "slides",
    "canvas",
    "design-system",
    "dashboard",
    "motion"
  ],
  "main": "./src/node.js",
  "agyPlugin": "./agy-plugin.json",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "files": [
    "agy-plugin.json",
    "settings.schema.json",
    "package.json",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "vendor-rewrites.json",
    "locales/",
    "src/",
    "tools/",
    "references/",
    "templates/",
    "assets/",
    "vendor/"
  ],
  "scripts": {
    "test": "node -e \"const cp=require('node:child_process'),fs=require('node:fs'),p=require('node:path');const files=fs.readdirSync('test').filter(f=>f.endsWith('.test.js')||f.endsWith('.test.mjs')).sort().map(f=>p.join('test',f));process.exit(cp.spawnSync(process.execPath,['--test',...files],{stdio:'inherit',env:{...process.env,AGY_DADDY_TEST_MODE:'1'}}).status??1)\"",
    "verify": "node scripts/verify.js",
    "package": "bash bin/package.sh"
  },
  "engines": {
    "node": ">=22.4.0"
  }
}
